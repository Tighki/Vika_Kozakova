<%#
  variant: 'mark' | 'full'
  className: optional extra CSS class
%>
<% const logoClass = 'logo' + (typeof className !== 'undefined' ? ' ' + className : ''); %>
<% if (variant === 'full') { %>
<img src="/images/logo.svg" alt="DocFlow" class="<%= logoClass %> logo-full" width="168" height="40">
<% } else { %>
<img src="/images/logo-mark.svg" alt="DocFlow" class="<%= logoClass %> logo-mark" width="40" height="40">
<% } %>
