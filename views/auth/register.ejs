<%- include('../partials/errors') %>

<form method="POST" action="/register" class="form" id="register-form">
  <div class="form-group">
    <label for="email">Email</label>
    <input type="email" id="email" name="email" value="<%= form.email || '' %>" required>
  </div>
  <div class="form-group">
    <label for="full_name">ФИО</label>
    <input type="text" id="full_name" name="full_name" value="<%= form.full_name || '' %>" required>
  </div>
  <div class="form-group">
    <label for="password">Пароль</label>
    <input type="password" id="password" name="password" required>
  </div>
  <div class="form-group">
    <label for="password_confirm">Подтверждение пароля</label>
    <input type="password" id="password_confirm" name="password_confirm" required>
  </div>
  <%- include('../partials/rules', {
    rules: registerRules,
    enabledRules: enabledRules || registerRules,
    hint: 'Отметьте правила — форма будет проверена по ним перед отправкой.'
  }) %>
  <div id="client-errors" class="alert alert-error" hidden></div>
  <button type="submit" class="btn btn-primary btn-block">Зарегистрироваться</button>
</form>

<p class="auth-footer">Уже есть аккаунт? <a href="/login">Войти</a></p>
