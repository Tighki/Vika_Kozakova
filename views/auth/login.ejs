<%- include('../partials/errors') %>

<form method="POST" action="/login" class="form">
  <div class="form-group">
    <label for="email">Email</label>
    <input type="email" id="email" name="email" value="<%= form.email || '' %>" required placeholder="user@docflow.local">
  </div>
  <div class="form-group">
    <label for="password">Пароль</label>
    <input type="password" id="password" name="password" required>
  </div>
  <button type="submit" class="btn btn-primary btn-block">Войти</button>
</form>

<p class="auth-footer">Нет аккаунта? <a href="/register">Зарегистрироваться</a></p>

<div class="demo-credentials">
  <p><strong>Демо:</strong> admin@docflow.local / Admin123! · user@docflow.local / User123!</p>
</div>
