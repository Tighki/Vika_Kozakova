<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — DocFlow</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
  <link rel="icon" href="/images/logo-mark.svg" type="image/svg+xml">
</head>
<body class="auth-body">
  <div class="auth-wrapper">
    <div class="auth-card">
      <div class="auth-header">
        <%- include('partials/logo', { variant: 'full', className: 'logo-auth' }) %>
        <p>ИС автоматизации документооборота</p>
      </div>
      <% if (typeof flash !== 'undefined' && flash) { %>
      <div class="toast toast-<%= flash.type %>"><%= flash.message %></div>
      <% } %>
      <%- body %>
    </div>
  </div>
  <script src="/js/validation.js"></script>
</body>
</html>
